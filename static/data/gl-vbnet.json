net","category":"デバッグとVBAとの違い","term":"ブレークポイント / F5, F10, F11","summary":"停止位置／実行／ステップオーバー／ステップイン。","examples":[],"pages":[],"id":"vbnet-0124"},{"lang":"vbnet","category":"デバッグとVBAとの違い","term":"VBA との違い","summary":"VB.NET は型の厳密さ、クラスの機能、非同期処理などが強化された言語で、VBA とは別物です。","examples":[],"pages":[],"id":"vbnet-0125"},{"lang":"vbnet","category":"デバッグとVBAとの違い","term":"VB6 からの移行","summary":"構文は似ていますが、言語・ライブラリが大きく変わりました。","examples":[],"pages":[],"id":"vbnet-0126"}]}