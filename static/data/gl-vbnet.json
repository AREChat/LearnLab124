"examples":[{"code":"String.Join(\",\", s.Split(\" \"c))","note":""}],"pages":[],"id":"vbnet-0181"},{"lang":"vbnet","category":"文字列","term":"Normalize","summary":"Unicode の正規化（全角・半角などのゆれ対策）。","examples":[{"code":"s.Normalize(NormalizationForm.FormKC)","note":""}],"pages":[],"id":"vbnet-0182"},{"lang":"vbnet","category":"文字列","term":"文字列の比較 CompareOrdinal","summary":"文字コードの順で比較する。","examples":[{"code":"String.CompareOrdinal(a, b)","note":""}],"pages":[],"id":"vbnet-0183"},{"lang":"vbnet","category":"文字列","term":"複数行文字列","summary":"改行を含む文字列を書く。","examples":[{"code":"Dim s = \"A\" & vbCrLf & \"B\"","note":""}],"pages":[],"id":"vbnet-0184"},{"lang":"vbnet","category":"制御構文","term":"If 1行","summary":"1行で条件分岐を書く。","examples":[{"code":"If n > 0 Then Console.WriteLine(\"正\")","note":""}],"pages":[],"id":"vbnet-0185"},{"lang":"vbnet","category":"制御構文","term":"Select Case Is","summary":"比較演算子で範囲を指定する。","examples":[{"code":"Case Is >= 80","note":""}],"pages":[],"id":"vbnet-0186"},{"lang":"vbnet","category":"制御構文","term":"Select Case To","summary":"範囲を指定する。","examples":[{"code":"Case 1 To 5","note":""}],"pages":[],"id":"vbnet-0187"},{"lang":"vbnet","category":"制御構文","term":"Select Case True","summary":"条件式ごとに分岐する書き方。","examples":[{"code":"Select Case True","note":""}],"pages":[],"id":"vbnet-0188"},{"lang":"vbnet","category":"制御構文","term":"For Step","summary":"増分を指定する。","examples":[{"code":"For i = 10 To 0 Step -2","note":""}],"pages":[],"id":"vbnet-0189"},{"lang":"vbnet","category":"制御構文","term":"For Each と Index","summary":"順番を数えながら繰り返す。","examples":[{"code":"For Each x In list","note":""}],"pages":[],"id":"vbnet-0190"},{"lang":"vbnet","category":"制御構文","term":"Do Until","summary":"条件が成り立つまで繰り返す。","examples":[{"code":"Do Until n = 0","note":""}],"pages":[],"id":"vbnet-0191"},{"lang":"vbnet","category":"制御構文","term":"Do ... Loop While","summary":"1回は実行してから条件を調べる。","examples":[{"code":"Do : n += 1 : Loop While n < 10","note":""}],"pages":[],"id":"vbnet-0192"},{"lang":"vbnet","ca