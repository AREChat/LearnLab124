:""}],"pages":[],"id":"vbnet-0090"},{"lang":"vbnet","category":"LINQ","term":"Sum / Count / Average","summary":"集計。","examples":[{"code":"list.Sum()","note":""}],"pages":[],"id":"vbnet-0091"},{"lang":"vbnet","category":"LINQ","term":"First / FirstOrDefault","summary":"最初の要素。なければ例外／既定値。","examples":[{"code":"list.FirstOrDefault()","note":""}],"pages":[],"id":"vbnet-0092"},{"lang":"vbnet","category":"LINQ","term":"GroupBy","summary":"グループ分け。","examples":[{"code":"list.GroupBy(Function(x) x.City)","note":""}],"pages":[],"id":"vbnet-0093"},{"lang":"vbnet","category":"LINQ","term":"Any / All","summary":"1つでも／すべてが条件に合うか。","examples":[{"code":"list.Any(Function(x) x > 5)","note":""}],"pages":[],"id":"vbnet-0094"},{"lang":"vbnet","category":"LINQ","term":"クエリ式 From...Select","summary":"SQL に似た書き方。","examples":[{"code":"From x In list Where x > 1 Select x","note":""}],"pages":[],"id":"vbnet-0095"},{"lang":"vbnet","category":"ファイルと入出力","term":"File.ReadAllText","summary":"ファイル全体を文字列で読む。","examples":[{"code":"File.ReadAllText(\"a.txt\")","note":""}],"pages":[],"id":"vbnet-0096"},{"lang":"vbnet","category":"ファイルと入出力","term":"File.WriteAllText","summary":"文字列をファイルへ書く。","examples":[{"code":"File.WriteAllText(\"a.txt\", \"hi\")","note":""}],"pages":[],"id":"vbnet-0097"},{"lang":"vbnet","category":"ファイルと入出力","term":"File.ReadAllLines","summary":"行ごとの配列で読む。","examples":[{"code":"File.ReadAllLines(\"a.txt\")","note":""}],"pages":[],"id":"vbnet-0098"},{"lang":"vbnet","category":"ファイルと入出力","term":"StreamReader / StreamWriter","summary":"ファイルを逐次読み書き。","examples":[{"code":"Using w As New StreamWriter(\"a.txt\")","note":""}],"pages":[],"id":"vbnet-0099"},{"lang":"vbnet","category":"ファイルと入出力","term":"Path","summary":"パスの結合や分解。","examples":[{"code":"Path.Combine(\"dir\", \"a.txt\")","note":""}],"pages":[],"id":"vbnet-0100"},{"lang":"vbnet","category":"ファイルと入出力","term":"Directory","summary":"フォルダの操作。","examples":[{"code":"Directory.GetFiles(\"dir\")","note":""}],"pages":[],"id":"vbnet-0101"}