{"version":1,"entries":[{"lang":"php","category":"基本","term":"<?php ?>","summary":"PHP のコードを書く範囲を示すタグ。ファイルが PHP だけなら閉じタグは省略します。","examples":[{"code":"<?php\necho \"Hello\";","note":""}],"pages":[],"id":"php-0001"},{"lang":"php","category":"基本","term":"echo / print","summary":"文字列を出力します。","examples":[{"code":"echo \"こんにちは\";","note":""}],"pages":[],"id":"php-0002"},{"lang":"php","category":"基本","term":"変数 $","summary":"変数名の先頭に $ を付けます。型の宣言は不要です。","examples":[{"code":"$name = \"太郎\";","note":""}],"pages":[],"id":"php-0003"},{"lang":"php","category":"基本","term":"定数 define / const","summary":"変更できない値を定義します。","examples":[{"code":"const TAX = 0.1;\ndefine(\"SITE\", \"ARE\");","note":""}],"pages":[],"id":"php-0004"},{"lang":"php","category":"基本","term":"コメント","summary":"// と # は1行、/* */ は複数行です。","examples":[{"code":"// メモ","note":""}],"pages":[],"id":"php-0005"},{"lang":"php","category":"基本","term":"ヒアドキュメント","summary":"長い文字列を複数行で書く記法。","examples":[{"code":"$t = <<<EOT\n行1\n行2\nEOT;","note":""}],"pages":[],"id":"php-0006"},{"lang":"php","category":"基本","term":"変数展開","summary":"ダブルクォートの中では $変数 や {$配列['key']} が展開されます。","examples":[{"code":"echo \"名前は{$name}です\";","note":""}],"pages":[],"id":"php-0007"},{"lang":"php","category":"基本","term":"var_dump","summary":"値の型と中身を表示します。デバッグ用です。","examples":[{"code":"var_dump($x);","note":""}],"pages":[],"id":"php-0008"},{"lang":"php","category":"基本","term":"print_r","summary":"配列などを読みやすい形で出力します。","examples":[{"code":"print_r($arr);","note":""}],"pages":[],"id":"php-0009"},{"lang":"php","category":"基本","term":"isset / empty","summary":"変数が定義済みで null でないか／空か、を調べます。","examples":[{"code":"if (isset($_GET[\"id\"])) { }","note":""}],"pages":[],"id":"php-0010"},{"lang":"php","category":"基本","term":"unset","summary":"変数や配列の要素を削除します。","examples":[{"code":"unset($a[\"k\"]);","note":""}],"pages":[],"id":"php-0011"},{"lang":"php","category":"基本","term":"strict_types","summary":"型の自動変換を厳しくするため、ファイル先頭に書きます。","examples":[{"code":"declare(strict_types=1);","note":""}],"pages":[],"id":"php-0012"},{"lang":"php","category":"基本","term":"null合体演算子","summary":"?? で、未定義または null のときの既定値を指定します。","examples":[{"code":"$id = $_GET[\"id\"] ?? 0;","note":""}],"pages":[],"id":"php-0013"},{"lang":"php","category":"基本","term":"スペースシップ演算子","summary":"<=> は大小を -1, 0, 1 で返します。並べ替えに便利です。","examples":[{"code":"1 <=> 2; // -1","note":""}],"pages":[],"id":"php-0014"},{"lang":"php","category":"データ型","term":"int / float","summary":"整数／小数。","examples":[{"code":"$n = 10;\n$f = 1.5;","note":""}],"pages":[],"id":"php-0015"},{"lang":"php","category":"データ型","term":"string","summary":"文字列。シングルクォートは変数展開されません。","examples":[{"code":"$s = 'abc';","note":""}],"pages":[],"id":"php-0016"},{"lang":"php","category":"データ型","term":"bool","summary":"true / false。","examples":[{"code":"$ok = true;","note":""}],"pages":[],"id":"php-0017"},{"lang":"php","category":"データ型","term":"array","summary":"順序付きの連想配列。キーは整数か文字列。","examples":[{"code":"$a = [\"x\" => 1, \"y\" => 2];","note":""}],"pages":[],"id":"php-0018"},{"lang":"php","category":"データ型","term":"型変換 (int) など","summary":"値を指定した型へ変換します。","examples":[{"code":"(int)\"12abc\"; // 12","note":""}],"pages":[],"id":"php-0019"},{"lang":"php","category":"データ型","term":"gettype / is_*","summary":"型を調べます。","examples":[{"code":"is_numeric(\"12\"); // true","note":""}],"pages":[],"id":"php-0020"},{"lang":"php","category":"データ型","term":"null","summary":"値がないことを表します。","examples":[{"code":"$v = null;","note":""}],"pages":[],"id":"php-0021"},{"lang":"php","category":"データ型","term":"ユニオン型","summary":"複数の型を許す型指定（PHP 8以降）。","examples":[{"code":"function f(int|string $v) { }","note":""}],"pages":[],"id":"php-0022"},{"lang":"php","category":"データ型","term":"enum","summary":"決まった値だけを持つ型（PHP 8.1以降）。","examples":[{"code":"enum Suit: string { case Heart = \"H\"; }","note":""}],"pages":[],"id":"php-0023"},{"lang":"php","category":"演算子","term":". （連結）","summary":"文字列をつなげます。+ ではありません。","examples":[{"code":"\"a\" . \"b\"; // \"ab\"","note":""}],"pages":[],"id":"php-0024"},{"lang":"php","category":"演算子","term":"== と ===","summary":"== は型変換して比較、=== は型も同じか比較します。通常は === を使います。","examples":[{"code":"0 == \"a\"; // PHP 8 では false","note":""}],"pages":[],"id":"php-0025"},{"lang":"php","category":"演算子","term":"?: （エルビス演算子）","summary":"左が真ならそれを、偽なら右を返します。","examples":[{"code":"$name ?: \"名無し\";","note":""}],"pages":[],"id":"php-0026"},{"lang":"php","category":"演算子","term":"@（エラー抑制）","summary":"エラー表示を抑えます。原因が見えなくなるため基本は避けます。","examples":[{"code":"@file_get_contents($f);","note":""}],"pages":[],"id":"php-0027"},{"lang":"php","category":"演算子","term":"match式","summary":"厳密比較で値に応じた結果を返す式（PHP 8以降）。","examples":[{"code":"$r = match($n) { 1 => \"一\", default => \"他\" };","note":""}],"pages":[],"id":"php-0028"},{"lang":"php","category":"制御構文","term":"if / elseif / else","summary":"条件分岐。","examples":[{"code":"if ($n > 0) { } elseif ($n < 0) { } else { }","note":""}],"pages":[],"id":"php-0029"},{"lang":"php","category":"制御構文","term":"switch","summary":"値で分岐します。break を忘れずに。","examples":[{"code":"switch ($d) { case 1: break; }","note":""}],"pages":[],"id":"php-0030"},{"lang":"php","category":"制御構文","term":"for","summary":"回数を決めたくり返し。","examples":[{"code":"for ($i = 0; $i < 3; $i++) { }","note":""}],"pages":[],"id":"php-0031"},{"lang":"php","category":"制御構文","term":"foreach","summary":"配列の要素を順に取り出します。","examples":[{"code":"foreach ($a as $k => $v) { }","note":""}],"pages":[],"id":"php-0032"},{"lang":"php","category":"制御構文","term":"while / do-while","summary":"条件が真の間くり返します。","examples":[{"code":"while ($n > 0) { $n--; }","note":""}],"pages":[],"id":"php-0033"},{"lang":"php","category":"制御構文","term":"break / continue","summary":"ループを抜ける／次へ進む。","examples":[{"code":"continue;","note":""}],"pages":[],"id":"php-0034"},{"lang":"php","category":"制御構文","term":"try / catch / finally","summary":"例外の処理です。","examples":[{"code":"try { throw new Exception(\"失敗\"); } catch (Exception $e) { echo $e->getMessage(); }","note":""}],"pages":[],"id":"php-0035"},{"lang":"php","category":"制御構文","term":"throw","summary":"例外を投げます。PHP 8 からは式としても使えます。","examples":[{"code":"throw new InvalidArgumentException(\"不正\");","note":""}],"pages":[],"id":"php-0036"},{"lang":"php","category":"制御構文","term":"alternative syntax","summary":"HTML に埋め込みやすい if: ... endif; の書き方。","examples":[{"code":"<?php if ($a): ?>表示<?php endif; ?>","note":""}],"pages":[],"id":"php-0037"},{"lang":"php","category":"関数","term":"function","summary":"関数を定義します。型を指定できます。","examples":[{"code":"function add(int $a, int $b): int { return $a + $b; }","note":""}],"pages":[],"id":"php-0038"},{"lang":"php","category":"関数","term":"デフォルト引数","summary":"省略時の初期値を決めます。","examples":[{"code":"function hi($n = \"ゲスト\") { }","note":""}],"pages":[],"id":"php-0039"},{"lang":"php","category":"関数","term":"名前付き引数","summary":"引数名を指定して呼べます（PHP 8以降）。","examples":[{"code":"f(b: 2, a: 1);","note":""}],"pages":[],"id":"php-0040"},{"lang":"php","category":"関数","term":"可変長引数","summary":"... で引数をまとめて受け取ります。","examples":[{"code":"function sum(...$n) { return array_sum($n); }","note":""}],"pages":[],"id":"php-0041"},{"lang":"php","category":"関数","term":"アロー関数","summary":"fn で短く書ける無名関数。外側の変数を自動で使えます。","examples":[{"code":"$f = fn($x) => $x * 2;","note":""}],"pages":[],"id":"php-0042"},{"lang":"php","category":"関数","term":"無名関数 use","summary":"無名関数で外側の変数を使うときは use で渡します。","examples":[{"code":"$f = function() use ($tax) { };","note":""}],"pages":[],"id":"php-0043"},{"lang":"php","category":"関数","term":"参照渡し &","summary":"引数を元の変数のまま受け取り、関数内の変更を反映させます。","examples":[{"code":"function inc(&$n) { $n++; }","note":""}],"pages":[],"id":"php-0044"},{"lang":"php","category":"関数","term":"static変数","summary":"関数を抜けても値を保持するローカル変数です。","examples":[{"code":"function c() { static $n = 0; return ++$n; }","note":""}],"pages":[],"id":"php-0045"},{"lang":"php","category":"関数","term":"global","summary":"関数の中でグローバル変数を使います。使いすぎは避けます。","examples":[{"code":"global $config;","note":""}],"pages":[],"id":"php-0046"},{"lang":"php","category":"関数","term":"nullsafe演算子","summary":"?-> で途中が null なら null を返します。","examples":[{"code":"$user?->address?->city;","note":""}],"pages":[],"id":"php-0047"},{"lang":"php","category":"文字列関数","term":"strlen / mb_strlen","summary":"バイト数／文字数。日本語には mb_strlen。","examples":[{"code":"mb_strlen(\"あい\"); // 2","note":""}],"pages":[],"id":"php-0048"},{"lang":"php","category":"文字列関数","term":"substr / mb_substr","summary":"文字列の一部を切り出します。日本語は mb_substr。","examples":[{"code":"mb_substr(\"あいう\", 1, 1); // い","note":""}],"pages":[],"id":"php-0049"},{"lang":"php","category":"文字列関数","term":"strpos / str_contains","summary":"位置を調べる／含むかを調べます。","examples":[{"code":"str_contains(\"abc\", \"b\");","note":""}],"pages":[],"id":"php-0050"},{"lang":"php","category":"文字列関数","term":"str_replace","summary":"文字列を置き換えます。","examples":[{"code":"str_replace(\"a\", \"b\", $s);","note":""}],"pages":[],"id":"php-0051"},{"lang":"php","category":"文字列関数","term":"explode / implode","summary":"区切って配列へ／配列をつなげて文字列へ。","examples":[{"code":"explode(\",\", \"a,b\");\nimplode(\"-\", $a);","note":""}],"pages":[],"id":"php-0052"},{"lang":"php","category":"文字列関数","term":"trim","summary":"前後の空白などを取り除きます。","examples":[{"code":"trim($s);","note":""}],"pages":[],"id":"php-0053"},{"lang":"php","category":"文字列関数","term":"sprintf / number_format","summary":"書式付き文字列／3桁区切りの数値。","examples":[{"code":"number_format(1234567); // 1,234,567","note":""}],"pages":[],"id":"php-0054"},{"lang":"php","category":"文字列関数","term":"strtoupper / strtolower","summary":"大文字／小文字に変換します。","examples":[{"code":"strtoupper(\"abc\");","note":""}],"pages":[],"id":"php-0055"},{"lang":"php","category":"文字列関数","term":"htmlspecialchars","summary":"HTML の特殊文字を無害な形に変換します。画面表示前に使い、XSS を防ぎます。","examples":[{"code":"echo htmlspecialchars($s, ENT_QUOTES, \"UTF-8\");","note":""}],"pages":[],"id":"php-0056"},{"lang":"php","category":"文字列関数","term":"preg_match","summary":"正規表現で一致を調べます。","examples":[{"code":"preg_match('/^\\d+$/', $s);","note":""}],"pages":[],"id":"php-0057"},{"lang":"php","category":"文字列関数","term":"preg_replace","summary":"正規表現で置換します。","examples":[{"code":"preg_replace('/\\s+/', ' ', $s);","note":""}],"pages":[],"id":"php-0058"},{"lang":"php","category":"文字列関数","term":"mb_convert_encoding","summary":"文字コードを変換します。","examples":[{"code":"mb_convert_encoding($s, \"UTF-8\", \"SJIS\");","note":""}],"pages":[],"id":"php-0059"},{"lang":"php","category":"配列関数","term":"count","summary":"配列の要素数。","examples":[{"code":"count($a);","note":""}],"pages":[],"id":"php-0060"},{"lang":"php","category":"配列関数","term":"array_push / []","summary":"配列の末尾に追加します。","examples":[{"code":"$a[] = 4;","note":""}],"pages":[],"id":"php-0061"},{"lang":"php","category":"配列関数","term":"array_pop / array_shift","summary":"末尾／先頭の要素を取り出します。","examples":[{"code":"array_pop($a);","note":""}],"pages":[],"id":"php-0062"},{"lang":"php","category":"配列関数","term":"array_merge","summary":"配列を結合します。","examples":[{"code":"array_merge($a, $b);","note":""}],"pages":[],"id":"php-0063"},{"lang":"php","category":"配列関数","term":"array_map","summary":"全要素に関数を適用して新しい配列を返します。","examples":[{"code":"array_map(fn($n) => $n * 2, $a);","note":""}],"pages":[],"id":"php-0064"},{"lang":"php","category":"配列関数","term":"array_filter","summary":"条件に合う要素だけ残します。","examples":[{"code":"array_filter($a, fn($n) => $n > 0);","note":""}],"pages":[],"id":"php-0065"},{"lang":"php","category":"配列関数","term":"array_reduce","summary":"配列を1つの値にまとめます。","examples":[{"code":"array_reduce($a, fn($c, $n) => $c + $n, 0);","note":""}],"pages":[],"id":"php-0066"},{"lang":"php","category":"配列関数","term":"in_array","summary":"配列に値があるか調べます。第3引数を true にすると厳密比較。","examples":[{"code":"in_array(3, $a, true);","note":""}],"pages":[],"id":"php-0067"},{"lang":"php","category":"配列関数","term":"array_key_exists","summary":"キーがあるか調べます。","examples":[{"code":"array_key_exists(\"id\", $a);","note":""}],"pages":[],"id":"php-0068"},{"lang":"php","category":"配列関数","term":"array_keys / array_values","summary":"キー／値だけを取り出します。","examples":[{"code":"array_keys($a);","note":""}],"pages":[],"id":"php-0069"},{"lang":"php","category":"配列関数","term":"sort / usort","summary":"並べ替え／比較関数を指定した並べ替え。","examples":[{"code":"usort($a, fn($x, $y) => $x <=> $y);","note":""}],"pages":[],"id":"php-0070"},{"lang":"php","category":"配列関数","term":"array_slice","summary":"一部を取り出します。","examples":[{"code":"array_slice($a, 0, 3);","note":""}],"pages":[],"id":"php-0071"},{"lang":"php","category":"配列関数","term":"array_unique","summary":"重複を取り除きます。","examples":[{"code":"array_unique($a);","note":""}],"pages":[],"id":"php-0072"},{"lang":"php","category":"配列関数","term":"array_column","summary":"二次元配列から特定の列を取り出します。","examples":[{"code":"array_column($rows, \"name\");","note":""}],"pages":[],"id":"php-0073"},{"lang":"php","category":"配列関数","term":"compact / extract","summary":"変数から配列を作る／配列から変数を作る。","examples":[{"code":"compact(\"a\", \"b\");","note":""}],"pages":[],"id":"php-0074"},{"lang":"php","category":"配列関数","term":"list / 分割代入","summary":"配列の値を変数にまとめて取り出します。","examples":[{"code":"[$a, $b] = [1, 2];","note":""}],"pages":[],"id":"php-0075"},{"lang":"php","category":"クラス","term":"class","summary":"オブジェクトの設計図。","examples":[{"code":"class User { public string $name; }","note":""}],"pages":[],"id":"php-0076"},{"lang":"php","category":"クラス","term":"__construct","summary":"インスタンス作成時の初期化。コンストラクタプロモーションで短く書けます。","examples":[{"code":"public function __construct(private string $name) { }","note":""}],"pages":[],"id":"php-0077"},{"lang":"php","category":"クラス","term":"new","summary":"インスタンスを作ります。","examples":[{"code":"$u = new User();","note":""}],"pages":[],"id":"php-0078"},{"lang":"php","category":"クラス","term":"アクセス修飾子","summary":"public / protected / private。","examples":[{"code":"private int $age;","note":""}],"pages":[],"id":"php-0079"},{"lang":"php","category":"クラス","term":"static / ::","summary":"クラスに属するメソッド・プロパティ。:: で呼びます。","examples":[{"code":"User::count();","note":""}],"pages":[],"id":"php-0080"},{"lang":"php","category":"クラス","term":"継承 extends","summary":"親クラスを引き継ぎます。親の呼び出しは parent::。","examples":[{"code":"class Admin extends User { }","note":""}],"pages":[],"id":"php-0081"},{"lang":"php","category":"クラス","term":"interface","summary":"メソッドの約束事を定めます。","examples":[{"code":"interface Loggable { public function log(): void; }","note":""}],"pages":[],"id":"php-0082"},{"lang":"php","category":"クラス","term":"trait","summary":"複数のクラスで再利用できる部品。","examples":[{"code":"trait T { function hi() { } }\nclass A { use T; }","note":""}],"pages":[],"id":"php-0083"},{"lang":"php","category":"クラス","term":"abstract","summary":"単体では使えない、継承前提のクラス。","examples":[{"code":"abstract class Base { }","note":""}],"pages":[],"id":"php-0084"},{"lang":"php","category":"クラス","term":"マジックメソッド","summary":"__toString, __get, __call など、特定の場面で自動的に呼ばれるメソッド。","examples":[{"code":"public function __toString() { return $this->name; }","note":""}],"pages":[],"id":"php-0085"},{"lang":"php","category":"クラス","term":"namespace / use","summary":"名前の衝突を避けるための名前空間と、その取り込み。","examples":[{"code":"namespace App\\Models;\nuse App\\Models\\User;","note":""}],"pages":[],"id":"php-0086"},{"lang":"php","category":"クラス","term":"readonly プロパティ","summary":"初期化後に変更できないプロパティ（PHP 8.1以降）。","examples":[{"code":"public readonly int $id;","note":""}],"pages":[],"id":"php-0087"},{"lang":"php","category":"クラス","term":"instanceof","summary":"そのクラスのインスタンスか調べます。","examples":[{"code":"$u instanceof User;","note":""}],"pages":[],"id":"php-0088"},{"lang":"php","category":"クラス","term":"オートロード","summary":"必要なクラスのファイルを自動で読み込む仕組み。Composer の autoload.php が標準です。","examples":[{"code":"require __DIR__ . \"/vendor/autoload.php\";","note":""}],"pages":[],"id":"php-0089"},{"lang":"php","category":"Web連携","term":"$_GET / $_POST","summary":"URL のパラメータ／フォーム送信値を受け取ります。信頼せず検証します。","examples":[{"code":"$q = $_GET[\"q\"] ?? \"\";","note":""}],"pages":[],"id":"php-0090"},{"lang":"php","category":"Web連携","term":"$_SERVER","summary":"リクエストメソッドなどサーバーと実行の情報。","examples":[{"code":"$_SERVER[\"REQUEST_METHOD\"]","note":""}],"pages":[],"id":"php-0091"},{"lang":"php","category":"Web連携","term":"$_SESSION","summary":"ログイン状態などをサーバー側で保持します。使う前に session_start()。","examples":[{"code":"session_start();\n$_SESSION[\"uid\"] = 1;","note":""}],"pages":[],"id":"php-0092"},{"lang":"php","category":"Web連携","term":"$_COOKIE / setcookie","summary":"ブラウザに保存される小さなデータ。","examples":[{"code":"setcookie(\"k\", \"v\", [\"httponly\" => true]);","note":""}],"pages":[],"id":"php-0093"},{"lang":"php","category":"Web連携","term":"header","summary":"HTTP ヘッダーを送ります。リダイレクトにも使います。出力より前に呼ぶ必要があります。","examples":[{"code":"header(\"Location: /login.php\");\nexit;","note":""}],"pages":[],"id":"php-0094"},{"lang":"php","category":"Web連携","term":"ファイルアップロード $_FILES","summary":"アップロードされたファイルの情報。move_uploaded_file で保存します。","examples":[{"code":"move_uploaded_file($_FILES[\"f\"][\"tmp_name\"], $dest);","note":""}],"pages":[],"id":"php-0095"},{"lang":"php","category":"Web連携","term":"filter_var","summary":"値の検証・無害化。メールアドレスなどを検査します。","examples":[{"code":"filter_var($m, FILTER_VALIDATE_EMAIL);","note":""}],"pages":[],"id":"php-0096"},{"lang":"php","category":"Web連携","term":"json_encode / json_decode","summary":"配列と JSON を相互変換します。","examples":[{"code":"json_encode($a, JSON_UNESCAPED_UNICODE);","note":""}],"pages":[],"id":"php-0097"},{"lang":"php","category":"Web連携","term":"file_get_contents","summary":"ファイルまたは URL の内容を読み込みます。","examples":[{"code":"file_get_contents(\"a.txt\");","note":""}],"pages":[],"id":"php-0098"},{"lang":"php","category":"Web連携","term":"cURL","summary":"PHP から HTTP 通信を行う拡張。","examples":[{"code":"$ch = curl_init($url);","note":""}],"pages":[],"id":"php-0099"},{"lang":"php","category":"Web連携","term":"CSRF 対策","summary":"フォームに一度きりの秘密のトークンを埋め込み、他サイトからの不正送信を防ぎます。","examples":[{"code":"$_SESSION[\"token\"] = bin2hex(random_bytes(16));","note":""}],"pages":[],"id":"php-0100"},{"lang":"php","category":"データベース","term":"PDO","summary":"データベースへ接続する標準の仕組み。DB の種類を変えやすい。","examples":[{"code":"$pdo = new PDO($dsn, $user, $pass);","note":""}],"pages":[],"id":"php-0101"},{"lang":"php","category":"データベース","term":"プリペアドステートメント","summary":"値を後から埋め込むことで SQL インジェクションを防ぎます。","examples":[{"code":"$st = $pdo->prepare(\"SELECT * FROM u WHERE id = ?\");\n$st->execute([$id]);","note":""}],"pages":[],"id":"php-0102"},{"lang":"php","category":"データベース","term":"fetch / fetchAll","summary":"結果を1行／すべて取得します。","examples":[{"code":"$rows = $st->fetchAll(PDO::FETCH_ASSOC);","note":""}],"pages":[],"id":"php-0103"},{"lang":"php","category":"データベース","term":"トランザクション","summary":"複数の更新をまとめて確定、または取り消します。","examples":[{"code":"$pdo->beginTransaction();\n$pdo->commit();","note":""}],"pages":[],"id":"php-0104"},{"lang":"php","category":"データベース","term":"lastInsertId","summary":"直前に挿入した行の自動採番 ID を取得します。","examples":[{"code":"$pdo->lastInsertId();","note":""}],"pages":[],"id":"php-0105"},{"lang":"php","category":"データベース","term":"password_hash","summary":"パスワードを安全にハッシュ化します。保存はこの値を使います。","examples":[{"code":"password_hash($pw, PASSWORD_DEFAULT);","note":""}],"pages":[],"id":"php-0106"},{"lang":"php","category":"データベース","term":"password_verify","summary":"入力パスワードとハッシュを照合します。","examples":[{"code":"password_verify($pw, $hash);","note":""}],"pages":[],"id":"php-0107"},{"lang":"php","category":"日付と時刻","term":"date","summary":"日時を書式付き文字列で返します。","examples":[{"code":"date(\"Y-m-d H:i:s\");","note":""}],"pages":[],"id":"php-0108"},{"lang":"php","category":"日付と時刻","term":"time / strtotime","summary":"現在のUNIX時間／文字列から時刻を得ます。","examples":[{"code":"strtotime(\"+1 day\");","note":""}],"pages":[],"id":"php-0109"},{"lang":"php","category":"日付と時刻","term":"DateTime","summary":"日時を扱うクラス。modify や diff で計算できます。","examples":[{"code":"$d = new DateTime(\"now\", new DateTimeZone(\"Asia/Tokyo\"));","note":""}],"pages":[],"id":"php-0110"},{"lang":"php","category":"日付と時刻","term":"date_default_timezone_set","summary":"既定のタイムゾーンを設定します。","examples":[{"code":"date_default_timezone_set(\"Asia/Tokyo\");","note":""}],"pages":[],"id":"php-0111"},{"lang":"php","category":"ツール","term":"Composer","summary":"PHP のパッケージ管理ツール。","examples":[{"code":"composer require monolog/monolog","note":""}],"pages":[],"id":"php-0112"},{"lang":"php","category":"ツール","term":"php.ini","summary":"PHP の動作設定ファイル。エラー表示やアップロード上限などを設定します。","examples":[],"pages":[],"id":"php-0113"},{"lang":"php","category":"ツール","term":"error_reporting / display_errors","summary":"エラーの報告範囲／画面表示。本番では表示しないのが基本です。","examples":[{"code":"ini_set(\"display_errors\", \"0\");","note":""}],"pages":[],"id":"php-0114"},{"lang":"php","category":"ツール","term":"PHPUnit","summary":"PHP のテストフレームワーク。","examples":[],"pages":[],"id":"php-0115"},{"lang":"php","category":"ツール","term":"WordPress","summary":"PHP 製の代表的なコンテンツ管理システム（CMS）。テーマやプラグインで拡張します。","examples":[],"pages":[],"id":"php-0116"},{"lang":"php","category":"ツール","term":"Laravel","summary":"人気の PHP フレームワーク。ルーティング・DB・認証が整っています。","examples":[{"code":"Route::get(\"/\", fn() => view(\"home\"));","note":""}],"pages":[],"id":"php-0117"}]}